# Copy to .env and adjust values.
DATABASE_URL="postgresql://fikrianggara@localhost:5432/form_gen"
SESSION_SECRET="replace-with-a-long-random-string"
OPTION_PROXY_TIMEOUT_MS=5000

# Public base URL of the deployed app. Used to build ABSOLUTE invitation links
# in invitation emails (`<APP_URL>/f/<slug>?invite=<token>`). When unset, links
# stay relative — fine for the console/dev mail fallback, broken for real SMTP.
# APP_URL="https://forms.example.com"

# Optional: RAG LLM provider (OpenAI-compatible chat completions).
# When LLM_API_KEY is set, questionnaire title/description are generated by the
# model; otherwise a deterministic extractive generator is used.
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"

# Optional: embedding provider for semantic (vector) retrieval in RAG.
# When configured, retrieval blends pgvector cosine similarity with trigram
# similarity (hybrid search). Run `npm run db:embed` after configuring to
# backfill embeddings for the question bank.
# EMBEDDING_DIM must match the model's output dimension and the vector column
# (default 1024, as used by the migration).
LLM_EMBEDDING_API_KEY=""
LLM_EMBEDDING_BASE_URL="https://api.openai.com/v1"
LLM_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1024
